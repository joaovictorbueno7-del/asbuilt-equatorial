ENV=development
APP_NAME=OPS AI GRID
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=true

SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_ALGORITHM=HS256

FERNET_KEY=CHANGE_ME_generate_with_Fernet_generate_key

DATABASE_URL=sqlite+aiosqlite:///./ops_ai_grid.db

QUEUE_BACKEND=inprocess

REDIS_URL=

RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5

ANTHROPIC_API_KEY=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

ADMIN_EMAIL=admin@opsaigrid.local
